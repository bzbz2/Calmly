# Neon Postgres connection string (https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Auth.js secret: run `openssl rand -base64 32`
AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional sign-in buttons. Each shows only when its keys are set.
# Google: https://console.cloud.google.com/apis/credentials (redirect URI: <site>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple: Services ID + a client-secret JWT (redirect URI: <site>/api/auth/callback/apple; HTTPS only)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
